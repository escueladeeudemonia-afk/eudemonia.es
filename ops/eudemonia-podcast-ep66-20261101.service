[Unit]
Description=Publicación autorizada del episodio 66 de Eudemonía (PR 75)
StartLimitIntervalSec=0

[Service]
Type=oneshot
Environment=GITHUB_REPOSITORY=escueladeeudemonia-afk/eudemonia.es
Environment=GITHUB_REF=refs/heads/main
Environment=DRY_RUN=false
Environment=PATH=/usr/local/bin:/usr/bin:/bin
WorkingDirectory=%h/.local/lib/eudemonia-podcast-ep66-20261101
ExecStart=/usr/bin/node %h/.local/lib/eudemonia-podcast-ep66-20261101/publish-episode-66.mjs
