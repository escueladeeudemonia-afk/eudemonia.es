FROM node:22-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build
RUN npm prune --omit=dev

FROM node:22-alpine
WORKDIR /app
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/package.json ./package.json
COPY --from=build /app/dist ./dist
COPY editorial ./editorial
RUN mkdir /data && chown node:node /data
USER node
ENV EDITORIAL_DB=/data/editorial.sqlite EDITORIAL_HOST=0.0.0.0 EDITORIAL_STATIC_DIR=/app/dist PORT=4322
ENV EDITORIAL_ORIGIN=https://eudemonia.es EDITORIAL_PUBLISH_ENABLED=false
VOLUME /data
EXPOSE 4322
HEALTHCHECK --interval=30s --timeout=5s CMD node -e "fetch('http://127.0.0.1:4322/healthz').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
CMD ["node", "editorial/server.mjs"]
