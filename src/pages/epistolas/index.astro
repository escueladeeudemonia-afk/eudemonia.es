---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";

const isDev = import.meta.env.DEV;
const epistolas = (await getCollection("epistolas", ({ data }) => isDev || !data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);

const dateFmt = new Intl.DateTimeFormat("es-ES", { month: "long", year: "numeric" });
---

<Base
  title="Epístolas desde la Escuela — Eudemonía"
  description="Cada mes, una carta a la comunidad de Eudemonía. Reflexiones sobre cómo vivir una buena vida, novedades de la Escuela y algún recado. Aquí están todas."
  canonical="/epistolas"
>
  <section class="mx-auto max-w-[var(--container-content)] px-6 pt-20 pb-16 md:pt-28">
    <p class="eyebrow mb-6">Epístolas</p>
    <h1 class="text-4xl md:text-6xl font-semibold tracking-tight leading-[1.05] text-[var(--color-tinta)]">
      Epístolas desde la Escuela
    </h1>
    <p class="mt-6 text-lg md:text-xl text-[var(--color-cuerpo)] leading-relaxed max-w-2xl">
      Cada mes, Pablo —y de vez en cuando alguno de los mentores— escribe una carta a la comunidad.
      Reflexiones sobre cómo vivir una buena vida, novedades de la Escuela y algún que otro recado.
      Sin prisa y sin ruido. Aquí están todas, desde la primera.
    </p>
  </section>

  <section class="mx-auto max-w-[var(--container-content)] px-6 py-16 border-t border-black/5">
    <h2 class="sr-only">Todas las epístolas</h2>

    {epistolas.length === 0 ? (
      <p class="text-[var(--color-muted)] text-lg">Aún no hay epístolas publicadas. Vuelve pronto.</p>
    ) : (
      <ul class="divide-y divide-black/5">
        {epistolas.map((ep) => (
          <li>
            <a
              href={`/epistolas/${ep.slug}`}
              class="group flex flex-col md:flex-row md:items-baseline gap-2 md:gap-6 py-6 no-underline"
            >
              <div class="md:w-36 shrink-0 flex items-baseline gap-3 md:gap-2">
                {ep.data.number !== undefined && (
                  <span class="font-mono text-sm text-[var(--color-granate)]">
                    #{ep.data.number}
                  </span>
                )}
                <time
                  datetime={ep.data.pubDate.toISOString()}
                  class="text-xs text-[var(--color-muted)] uppercase tracking-wider"
                >
                  {dateFmt.format(ep.data.pubDate)}
                </time>
              </div>
              <div class="flex-1">
                <h3 class="text-xl md:text-2xl font-semibold text-[var(--color-tinta)] group-hover:text-[var(--color-granate)] transition-colors">
                  {ep.data.title}
                </h3>
                <p class="mt-1 text-sm text-[var(--color-muted)]">Por {ep.data.author}</p>
                <p class="mt-3 text-[var(--color-cuerpo)] leading-relaxed">
                  {ep.data.description}
                </p>
              </div>
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
</Base>
