---
import { getCollection, type CollectionEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import EpistolaArticle from "../../components/EpistolaArticle.astro";

export async function getStaticPaths() {
  const isDev = import.meta.env.DEV;
  const epistolas = await getCollection("epistolas", ({ data }) => isDev || !data.draft);
  return epistolas.map((ep) => ({
    params: { slug: ep.slug },
    props: { epistola: ep },
  }));
}

type Props = { epistola: CollectionEntry<"epistolas"> };
const { epistola } = Astro.props;
const { Content } = await epistola.render();
const { data } = epistola;

const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? "https://eudemonia.es";
const epistolaUrl = data.canonicalUrl ?? `${siteUrl}/epistolas/${epistola.slug}/`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  url: epistolaUrl,
  headline: data.title,
  description: data.description,
  datePublished: data.pubDate.toISOString(),
  author: { "@type": "Person", name: data.author },
  publisher: {
    "@type": "Organization",
    name: "Fundación Eudemonía",
    url: siteUrl,
  },
  isPartOf: {
    "@type": "CreativeWorkSeries",
    name: "Epístolas desde la Escuela",
    url: `${siteUrl}/epistolas`,
  },
};

const breadcrumbsLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Inicio", item: siteUrl },
    { "@type": "ListItem", position: 2, name: "Epístolas", item: `${siteUrl}/epistolas` },
    { "@type": "ListItem", position: 3, name: data.title, item: epistolaUrl },
  ],
};
---

<!-- noindex SOLO en las epístolas: serán réplicas del Substack que se lanzará durante 2026,
     y el original debe posicionar allí (decisión Pablo+Fran, 7-jul-2026).
     El podcast y el resto de eudemonia.es sí se indexan: es el sitio que tiene que posicionar. -->
<Base
  title={`${data.title} — Epístolas de Eudemonía`}
  description={data.description}
  canonical={epistolaUrl}
  noindex
>
  <EpistolaArticle data={data}><Content /></EpistolaArticle>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, "\\u003c")} is:inline />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbsLd).replace(/</g, "\\u003c")} is:inline />
</Base>
