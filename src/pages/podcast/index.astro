---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";

const isDev = import.meta.env.DEV;
const episodes = (await getCollection("episodes", ({ data }) => isDev || !data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);

const dateFmt = new Intl.DateTimeFormat("es-ES", { day: "numeric", month: "long", year: "numeric" });

// Plataformas de escucha. Solo se renderizan las que tienen href real.
const platforms = [
  { name: "Spotify", href: "https://open.spotify.com/show/3XRkHRPaWKjNXBy58XkaJD" },
  { name: "Apple Podcasts", href: "https://podcasts.apple.com/es/podcast/eudemon%C3%ADa-con-pablo-tovar/id1652887570" },
  { name: "Ivoox", href: "https://www.ivoox.com/podcast-eudemonia-pablo-tovar_sq_f11712611_1.html" },
  { name: "YouTube", href: "" },
  { name: "RSS", href: "/podcast/feed.xml" },
].filter((p) => p.href);
---

<Base
  title="Podcast — Eudemonía con Pablo Tovar"
  description="Eudemonía con Pablo Tovar: conversaciones y reflexiones sobre cómo vivir una buena vida. Ya son más de 60 episodios. ¿Qué te gustaría escuchar hoy?"
  canonical="/podcast"
>
  <section class="dotgrid relative overflow-hidden">
    <div class="mx-auto max-w-[var(--container-content)] px-6 pt-16 pb-10 md:pt-24 text-center">
      <span class="mx-auto mb-6 flex h-14 w-14 items-center justify-center rounded-full bg-[var(--color-granate-soft)] text-[var(--color-granate)]">
        <svg viewBox="0 0 352 512" width="24" height="24" fill="currentColor" aria-hidden="true">
          <path d="M176 352c53.02 0 96-42.98 96-96V96c0-53.02-42.98-96-96-96S80 42.98 80 96v160c0 53.02 42.98 96 96 96zm160-160h-16c-8.84 0-16 7.16-16 16v48c0 74.8-64.49 134.82-140.79 127.38C96.71 376.89 48 317.11 48 250.3V208c0-8.84-7.16-16-16-16H16c-8.84 0-16 7.16-16 16v40.16c0 89.64 63.97 169.55 152 181.69V464H96c-8.84 0-16 7.16-16 16v16c0 8.84 7.16 16 16 16h160c8.84 0 16-7.16 16-16v-16c0-8.84-7.16-16-16-16h-56v-33.77C285.71 418.47 352 344.9 352 256v-48c0-8.84-7.16-16-16-16z"></path>
        </svg>
      </span>
      <p class="eyebrow mb-4">Podcast</p>
      <h1 class="text-4xl md:text-6xl font-semibold tracking-tight leading-[1.05]">
        <span class="text-[var(--color-sec-rosa)]">Eudemonía</span>
        <span class="text-[var(--color-granate)]"> con Pablo Tovar</span>
      </h1>
      <h2 class="mt-8 text-2xl md:text-3xl font-semibold">
        <span class="text-[var(--color-sec-rosa)]">¿Qué te gustaría</span>
        <span class="text-[var(--color-granate)]"> escuchar hoy?</span>
      </h2>

      <div class="mx-auto mt-8 max-w-xl">
        <label for="ep-search" class="sr-only">Buscar un episodio</label>
        <input
          id="ep-search"
          type="search"
          autocomplete="off"
          placeholder="Busca por título…"
          class="w-full rounded-full border-2 border-[var(--color-tinta)]/15 bg-white px-5 py-3 text-[var(--color-cuerpo)] placeholder:text-[var(--color-muted)] focus:outline-none focus:border-[var(--color-granate)]"
        />
      </div>

      {platforms.length > 0 && (
        <div class="mt-6 flex flex-wrap justify-center gap-2.5 items-center text-sm">
          <span class="text-[var(--color-muted)] mr-1">Escúchalo en</span>
          {platforms.map((p) => (
            <a
              href={p.href}
              target={p.href.startsWith("http") ? "_blank" : undefined}
              rel={p.href.startsWith("http") ? "noopener noreferrer" : undefined}
              class="inline-flex items-center rounded-full border border-black/10 bg-white px-3.5 py-1 font-medium text-[var(--color-tinta)] no-underline hover:border-[var(--color-granate)]/30 hover:text-[var(--color-granate)] transition-colors"
            >
              {p.name}
            </a>
          ))}
        </div>
      )}
    </div>
  </section>

  <section class="mx-auto max-w-[var(--container-wide)] px-6 pb-24 pt-4">
    <ul id="ep-grid" class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {episodes.map((ep) => (
        <li class="ep-card" data-title={`${ep.data.title} ${ep.data.episodeNumber ?? ""}`.toLowerCase()}>
          <a
            href={`/podcast/${ep.slug}`}
            class="group flex h-full flex-col rounded-2xl border border-[var(--color-granate)]/20 bg-white p-6 no-underline transition-colors hover:border-[var(--color-granate)]/50"
          >
            <img src="/brand/isotipo.svg" alt="" width="28" height="28" class="mb-5 opacity-80" />
            {ep.data.episodeNumber !== undefined && (
              <span class="text-sm text-[var(--color-granate)] font-medium">
                Episodio {ep.data.episodeNumber}
              </span>
            )}
            <h3 class="mt-1 text-lg font-semibold leading-snug text-[var(--color-tinta)] group-hover:text-[var(--color-granate)] transition-colors">
              {ep.data.title}
            </h3>
            <span class="mt-auto pt-5 inline-flex items-center gap-1 text-sm text-[var(--color-granate)]">
              Ver más <span aria-hidden="true">→</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
    <p id="ep-empty" class="hidden text-center text-[var(--color-muted)] text-lg py-12">
      No hay episodios que coincidan con tu búsqueda.
    </p>
  </section>
</Base>

<script is:inline>
  (() => {
    const q = document.getElementById("ep-search");
    const cards = Array.from(document.querySelectorAll("#ep-grid .ep-card"));
    const empty = document.getElementById("ep-empty");
    if (!q) return;
    q.addEventListener("input", () => {
      const v = q.value.trim().toLowerCase();
      let visible = 0;
      cards.forEach((c) => {
        const match = !v || c.dataset.title.includes(v);
        c.style.display = match ? "" : "none";
        if (match) visible++;
      });
      if (empty) empty.classList.toggle("hidden", visible !== 0);
    });
  })();
</script>

<style>
  /* Patrón de puntos sutil de marca en el hero */
  .dotgrid {
    background-color: var(--color-papel);
    background-image: radial-gradient(circle, color-mix(in srgb, var(--color-granate) 8%, transparent) 1.5px, transparent 1.5px);
    background-size: 30px 30px;
    background-position: center top;
  }
</style>
