---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import MailerLiteForm from "../../components/MailerLiteForm.astro";
import PodcastItineraryLinks from "../../components/PodcastItineraryLinks.astro";
import { guiaPodcastHref } from "../../data/itinerarios-podcast";
import { formulariosMailerLite } from "../../data/suscripcion.mjs";

const isDev = import.meta.env.DEV;
const episodes = (await getCollection("episodes", ({ data }) => isDev || !data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);

// La landing evita estos signos sin modificar las fuentes editoriales ni sus URLs.
const tituloEnLanding = (title: string) => title.replace(/[:;]/g, ".");

// Plataformas de escucha. Solo se renderizan las que tienen href real.
const platforms = [
  { name: "Spotify", href: "https://open.spotify.com/show/3XRkHRPaWKjNXBy58XkaJD" },
  { name: "Apple Podcasts", href: "https://podcasts.apple.com/es/podcast/eudemon%C3%ADa-con-pablo-tovar/id1652887570" },
  { name: "Ivoox", href: "https://www.ivoox.com/podcast-eudemonia-pablo-tovar_sq_f11712611_1.html" },
  { name: "YouTube", href: "" },
  { name: "RSS", href: "/podcast/feed.xml" },
].filter((p) => p.href);
---

<Base
  title="Un pódcast para aprender a vivir bien — Eudemonía"
  description="Más de sesenta episodios de Pablo Tovar sobre cómo cuidar tu vida, tus decisiones y tu carácter. Escúchalos gratis y recibe una carta al mes de la Escuela."
  canonical="/podcast/"
>
  <section class="dotgrid relative overflow-hidden">
    <div class="mx-auto max-w-[var(--container-content)] px-6 pt-8 pb-10 md:pt-12 text-center">
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-semibold tracking-tight leading-[1.05]">
        <span class="text-[var(--color-sec-rosa)]">Un pódcast para</span>
        <span class="text-[var(--color-granate)]"> aprender a vivir bien</span>
      </h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg md:text-xl text-[var(--color-cuerpo)] leading-relaxed">
        Más de sesenta episodios de Pablo Tovar sobre cómo cuidar tu vida, tus decisiones y tu carácter.
      </p>

      <div class="mt-6 grid gap-6 lg:grid-cols-2 lg:gap-x-12 text-left">
        <div>
          <h2 class="text-xl font-medium text-[var(--color-granate)]">Quiénes somos</h2>
          <p class="mt-3 text-[var(--color-cuerpo)] leading-relaxed">
            Eudemonía es el pódcast de Pablo Tovar, director de la Fundación Eudemonía. Desde la Escuela compartimos conversaciones para vivir con más claridad y más calma. Puedes escucharlo gratis, sin inscribirte.
          </p>
        </div>

        <div id="suscribirse" class="mx-auto w-full max-w-md scroll-mt-24 lg:col-start-2 lg:row-start-1 lg:row-span-2">
          <h2 class="mb-4 text-xl font-medium text-[var(--color-granate)]">Recibir las epístolas</h2>
          <MailerLiteForm
            {...formulariosMailerLite.epistolas}
            leadMagnet="epistolas"
            redirectUrl="https://eudemonia.es/gracias/"
            submitLabel="Recibir las epístolas"
          />
          <p class="mt-3 text-sm text-center text-[var(--color-muted)]">
            Una carta al mes, gratis. Te puedes ir cuando quieras.
          </p>
        </div>

        <div class="lg:col-start-1 lg:row-start-2">
          <h2 class="text-xl font-medium text-[var(--color-granate)]">Qué vas a encontrar</h2>
          <ul class="mt-4 space-y-3 text-[var(--color-cuerpo)]">
            {[
              "Más de sesenta episodios abiertos, en Spotify, Apple Podcasts e Ivoox",
              "Una guía para empezar según lo que te está pasando ahora",
              "Una carta al mes de la Escuela, para leer con calma",
            ].map((item) => (
              <li class="flex items-start gap-3">
                <span class="mt-2 block w-1.5 h-1.5 rounded-full bg-[var(--color-granate)] shrink-0" />
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>

      {platforms.length > 0 && (
        <div class="mt-6 flex flex-wrap justify-center gap-2.5 items-center text-sm">
          <span class="text-[var(--color-muted)] mr-1">Escúchalo en</span>
          {platforms.map((p) => (
            <a
              href={p.href}
              target={p.href.startsWith("http") ? "_blank" : undefined}
              rel={p.href.startsWith("http") ? "noopener noreferrer" : undefined}
              class="inline-flex items-center rounded-full border border-black/10 bg-white px-3.5 py-1 font-medium text-[var(--color-tinta)] no-underline hover:border-[var(--color-granate)]/30 hover:text-[var(--color-granate)] transition-colors"
            >
              {p.name}
            </a>
          ))}
        </div>
      )}
    </div>
  </section>

  <section aria-labelledby="primera-vez" class="bg-[var(--color-papel-soft)]">
    <div class="mx-auto max-w-[var(--container-content)] px-6 py-10 text-center">
      <h2 id="primera-vez" class="text-2xl font-medium text-[var(--color-granate)]">¿Es tu primera vez?</h2>
      <p class="mx-auto mt-4 max-w-2xl leading-relaxed">Hay más de sesenta episodios. Elige lo que te trae y te propongo por dónde empezar.</p>
      <a href={guiaPodcastHref} class="mt-6 mb-5 inline-flex rounded-full border border-[var(--color-granate)] px-6 py-3 font-medium text-[var(--color-granate)] no-underline hover:bg-[var(--color-granate-soft)] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--color-granate)]">Empieza aquí</a>
      <nav aria-label="Itinerarios de escucha">
        <PodcastItineraryLinks baseHref={guiaPodcastHref} />
      </nav>
    </div>
  </section>

  <section class="mx-auto max-w-[var(--container-wide)] px-6 pb-24 pt-10">
    <h2 class="text-center text-3xl font-semibold text-[var(--color-granate)]">Todos los episodios</h2>
    <div class="mx-auto mt-6 mb-8 max-w-xl">
      <label for="ep-search" class="sr-only">Buscar un episodio</label>
      <input
        id="ep-search"
        type="search"
        autocomplete="off"
        placeholder="Busca por título…"
        class="w-full rounded-full border-2 border-[var(--color-tinta)]/15 bg-white px-5 py-3 text-[var(--color-cuerpo)] placeholder:text-[var(--color-muted)] focus:outline-none focus:border-[var(--color-granate)]"
      />
    </div>
    <ul id="ep-grid" class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {episodes.map((ep) => (
        <li class="ep-card" data-title={`${tituloEnLanding(ep.data.title)} ${ep.data.episodeNumber ?? ""}`.toLowerCase()}>
          <a
            href={`/podcast/${ep.slug}`}
            class="group flex h-full flex-col rounded-2xl border border-[var(--color-granate)]/20 bg-white p-6 no-underline transition-colors hover:border-[var(--color-granate)]/50"
          >
            <img src="/brand/isotipo.svg" alt="" width="28" height="28" class="mb-5 opacity-80" />
            {ep.data.episodeNumber !== undefined && (
              <span class="text-sm text-[var(--color-granate)] font-medium">
                Episodio {ep.data.episodeNumber}
              </span>
            )}
            <h3 class="mt-1 text-lg font-semibold leading-snug text-[var(--color-tinta)] group-hover:text-[var(--color-granate)] transition-colors">
              {tituloEnLanding(ep.data.title)}
            </h3>
            <span class="mt-auto pt-5 inline-flex items-center gap-1 text-sm text-[var(--color-granate)]">
              Ver más <span aria-hidden="true">→</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
    <p id="ep-empty" class="hidden text-center text-[var(--color-muted)] text-lg py-12">
      No hay episodios que coincidan con tu búsqueda.
    </p>
  </section>

  <section class="bg-[var(--color-papel-soft)] px-6 py-12">
    <div class="mx-auto max-w-md text-center">
      <h2 class="mb-6 text-2xl font-medium text-[var(--color-granate)]">Recibir las epístolas</h2>
      <MailerLiteForm
        {...formulariosMailerLite.epistolas}
        leadMagnet="epistolas"
        redirectUrl="https://eudemonia.es/gracias/"
        submitLabel="Recibir las epístolas"
        instanceSuffix="final"
        loadScript={false}
      />
      <p class="mt-3 text-sm text-[var(--color-muted)]">
        Una carta al mes, gratis. Te puedes ir cuando quieras.
      </p>
    </div>
  </section>
</Base>

<script is:inline>
  (() => {
    const q = document.getElementById("ep-search");
    const cards = Array.from(document.querySelectorAll("#ep-grid .ep-card"));
    const empty = document.getElementById("ep-empty");
    if (!q) return;
    q.addEventListener("input", () => {
      const v = q.value.trim().toLowerCase().replace(/[:;]/g, ".");
      let visible = 0;
      cards.forEach((c) => {
        const match = !v || c.dataset.title.includes(v);
        c.style.display = match ? "" : "none";
        if (match) visible++;
      });
      if (empty) empty.classList.toggle("hidden", visible !== 0);
    });
  })();
</script>

<style>
  /* Patrón de puntos sutil de marca en el hero */
  .dotgrid {
    background-color: var(--color-papel);
    background-image: radial-gradient(circle, color-mix(in srgb, var(--color-granate) 8%, transparent) 1.5px, transparent 1.5px);
    background-size: 30px 30px;
    background-position: center top;
  }
</style>
