---
import Base from "../layouts/Base.astro";
---

<Base
  title="Contenidos — Fundación Escuela de Eudemonía"
  description="Podcast Eudemonía, artículos y reflexiones sobre cómo vivir una buena vida."
  canonical="/contenidos"
>
  <section class="mx-auto max-w-[var(--container-content)] px-6 pt-20 pb-16 md:pt-28">
    <p class="text-sm uppercase tracking-[0.18em] text-[var(--color-granate)] font-medium mb-6">
      Contenidos
    </p>
    <h1 class="text-4xl md:text-6xl font-semibold tracking-tight leading-[1.05] text-[var(--color-tinta)]">
      Conversaciones, lecturas y reflexiones
    </h1>
    <p class="mt-6 text-lg md:text-xl text-[var(--color-cuerpo)] leading-relaxed max-w-2xl">
      Materiales públicos para acompañar el aprendizaje del arte de vivir bien.
    </p>
  </section>

  <section class="mx-auto max-w-[var(--container-content)] px-6 py-16 border-t border-black/5">
    <div class="grid md:grid-cols-2 gap-6">
      <a
        href="/contenidos/podcast"
        class="group rounded-2xl border border-black/5 bg-white p-8 md:p-10 no-underline hover:border-[var(--color-granate)]/30 transition-colors"
      >
        <p class="text-xs uppercase tracking-[0.18em] text-[var(--color-granate)] font-medium mb-3">
          Podcast
        </p>
        <h2 class="text-2xl font-semibold text-[var(--color-tinta)] mb-4">Podcast Eudemonía</h2>
        <p class="text-[var(--color-cuerpo)] leading-relaxed mb-6">
          Conversaciones sobre cómo vivir una buena vida. Pablo Tovar entrevista a personas que
          están en ese camino: científicos, filósofos, emprendedores, maestros, deportistas y gente
          corriente que ha tomado decisiones extraordinarias.
        </p>
        <span class="inline-flex items-center gap-1.5 text-[var(--color-granate)] font-medium group-hover:gap-2.5 transition-all">
          Escuchar episodios →
        </span>
      </a>

      <article class="rounded-2xl border border-black/5 bg-[var(--color-papel-soft)] p-8 md:p-10">
        <p class="text-xs uppercase tracking-[0.18em] text-[var(--color-granate)] font-medium mb-3">
          Artículos
        </p>
        <h2 class="text-2xl font-semibold text-[var(--color-tinta)] mb-4">Artículos y reflexiones</h2>
        <p class="text-[var(--color-cuerpo)] leading-relaxed mb-6">
          Textos sobre liderazgo, estoicismo, relaciones, trabajo con sentido y la aventura de vivir
          con propósito.
        </p>
        <p class="text-sm text-[var(--color-muted)]">Próximamente.</p>
      </article>
    </div>
  </section>
</Base>
