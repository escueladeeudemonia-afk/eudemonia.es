---
import Base from '../layouts/Base.astro';
---
<Base
  title="Cuaderno de relación · Escuela de Eudemonía"
  description="Una herramienta para trabajar tu relación por tu cuenta o en pareja, comparar perspectivas y elegir cambios concretos."
  canonical="/cuaderno-relacion/"
  noindex={true}
  chrome={false}
  analytics={false}
>
  <iframe
    src="/cuaderno-relacion/aplicacion.html"
    title="Cuaderno de relación: cuestionario individual o en pareja"
    class="cuaderno-frame"
    referrerpolicy="no-referrer"
  ></iframe>
  <noscript>Para responder al cuestionario necesitas activar JavaScript en tu navegador.</noscript>
</Base>
<style>
  .cuaderno-frame {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100vh;
    height: 100dvh;
    border: 0;
  }
</style>
