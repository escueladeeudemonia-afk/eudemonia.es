---
/**
 * BORRADOR DE LA PÁGINA DE VENTA DEL CREATUVIDA — no enlazada desde ningún sitio,
 * noindex y fuera del sitemap. La página pública sigue siendo /creatuvida/ y no cambia.
 * Existe para que Pablo valide la versión corta y estructurada propuesta el 3-sep-2026.
 *
 * TODO EL TEXTO VIVE EN src/data/creatuvida.yaml. Aquí solo hay maquetación.
 * Resumen y dudas en el repo de EDE: migracion/paginas/creatuvida.md
 * Cuando se apruebe, creatuvida.astro pasa a leer el mismo YAML (sin el aviso ni el
 * bloque final), se borra esta página y su exclusión del sitemap en astro.config.mjs.
 */
import Base from "../layouts/Base.astro";
import { parse } from "yaml";
import raw from "../data/creatuvida.yaml?raw";

const copy = parse(raw);
const { enlaces, hero, que_es, para_quien, que_te_llevas, como_funciona, facilitadores, fechas, precio, testimonios, preguntas, cierre, borrador } = copy;

// "@clave" → URL del bloque "enlaces" del YAML. Cualquier otra cosa se usa tal cual.
// Si la clave no existe, el build falla a propósito: mejor que un enlace roto en la web.
const url = (ref: string): string => {
  if (!ref.startsWith("@")) return ref;
  const destino = enlaces[ref.slice(1)];
  if (!destino) throw new Error(`creatuvida.yaml: el enlace "${ref}" no existe en el bloque "enlaces"`);
  return destino;
};

// Mini-markdown para los campos que admiten enlaces: [texto](@clave | URL) y **negrita**.
// Se escapa el HTML antes, así el YAML no puede inyectar etiquetas por accidente.
const md = (texto: string): string =>
  texto
    .replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;")
    .replace(/\[([^\]]+)\]\(([^)]+)\)/g, (_m, t, h) => `<a href="${url(h)}">${t}</a>`)
    .replace(/\*\*([^*]+)\*\*/g, "<strong>$1</strong>");

const punto = "mt-2.5 block w-1.5 h-1.5 rounded-full shrink-0";
const botonPrimario = "inline-flex items-center rounded-full bg-[var(--color-granate)] px-7 py-3 text-white font-medium no-underline hover:bg-[var(--color-granate-dark)] transition-colors";
const h2 = "text-3xl md:text-4xl font-semibold text-[var(--color-tinta)]";
const eyebrowGranate = "text-sm uppercase tracking-[0.18em] text-[var(--color-granate)] font-medium";
---

<Base
  title={`Borrador — ${copy.meta.titulo}`}
  description="Borrador interno de la nueva página de venta del CreaTuVida. No es la página pública."
  canonical="/creatuvida-borrador-9f2c"
  noindex
>
  {/* Aviso de borrador. Va fuera del diseño a propósito: no forma parte de la propuesta. */}
  <div class="bg-[var(--color-tinta)] text-white text-sm">
    <div class="mx-auto max-w-[var(--container-wide)] px-6 py-3 flex flex-wrap items-baseline gap-x-3 gap-y-1">
      <strong class="font-semibold">{borrador.aviso_titulo}</strong>
      <span class="opacity-80">{borrador.aviso_texto}</span>
    </div>
  </div>

  <!-- 1. Hero: qué es, en una frase, y los cuatro datos que importan -->
  <section class="mx-auto max-w-[var(--container-content)] px-6 pt-20 pb-14 md:pt-28">
    <p class="eyebrow mb-6">{hero.etiqueta}</p>
    <h1 class="text-4xl md:text-6xl font-semibold tracking-tight leading-[1.05] text-[var(--color-tinta)] max-w-3xl">
      {hero.titulo}
    </h1>
    <p class="mt-6 text-lg md:text-xl text-[var(--color-cuerpo)] leading-relaxed max-w-2xl">{hero.subtitulo}</p>

    <dl class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4 border-t border-black/10 pt-8">
      {hero.datos.map((d: { etiqueta: string; valor: string }) => (
        <div>
          <dt class="text-xs uppercase tracking-[0.18em] text-[var(--color-granate)] font-medium">{d.etiqueta}</dt>
          <dd class="mt-2 text-[var(--color-tinta)] font-medium leading-snug">{d.valor}</dd>
        </div>
      ))}
    </dl>

    <div class="mt-10 flex flex-wrap items-center gap-4">
      <a href="#precios" class={botonPrimario}>{hero.boton}</a>
      <a href="#como-funciona" class="font-medium">{hero.enlace_secundario}</a>
    </div>
  </section>

  <!-- 2. Qué es -->
  <section class="mx-auto max-w-[var(--container-content)] px-6 py-16 border-t border-black/5">
    <h2 class={h2}>{que_es.titulo}</h2>
    <div class="mt-6 space-y-5 text-lg text-[var(--color-cuerpo)] leading-relaxed max-w-[var(--container-prose)]">
      {que_es.parrafos.map((p: string) => <p>{p}</p>)}
    </div>
  </section>

  <!-- 3. Para quién es / para quién no -->
  <section class="bg-[var(--color-papel-soft)]">
    <div class="mx-auto max-w-[var(--container-content)] px-6 py-16">
      <h2 class={h2}>{para_quien.titulo}</h2>
      <div class="mt-8 grid gap-10 md:grid-cols-2">
        <div>
          <h3 class={eyebrowGranate}>{para_quien.es_para_ti.titulo}</h3>
          <ul class="mt-4 space-y-3 text-[var(--color-cuerpo)] leading-relaxed">
            {para_quien.es_para_ti.puntos.map((item: string) => (
              <li class="flex gap-3">
                <span class={`${punto} bg-[var(--color-granate)]`} />
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
        <div>
          <h3 class="text-sm uppercase tracking-[0.18em] text-[var(--color-muted)] font-medium">{para_quien.no_es_para_ti.titulo}</h3>
          <ul class="mt-4 space-y-3 text-[var(--color-cuerpo)] leading-relaxed">
            {para_quien.no_es_para_ti.puntos.map((item: string) => (
              <li class="flex gap-3">
                <span class={`${punto} bg-[var(--color-muted)]`} />
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Qué te llevas -->
  <section class="mx-auto max-w-[var(--container-content)] px-6 py-16">
    <h2 class={h2}>{que_te_llevas.titulo}</h2>
    <div class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      {que_te_llevas.puntos.map((r: { titulo: string; texto: string }) => (
        <article>
          <h3 class="text-xl font-semibold text-[var(--color-tinta)] mb-2">{r.titulo}</h3>
          <p class="text-[var(--color-cuerpo)] leading-relaxed">{r.texto}</p>
        </article>
      ))}
    </div>
  </section>

  <!-- 5. Cómo funciona -->
  <section id="como-funciona" class="bg-[var(--color-papel-soft)] scroll-mt-20">
    <div class="mx-auto max-w-[var(--container-content)] px-6 py-16">
      <h2 class={h2}>{como_funciona.titulo}</h2>
      <ol class="mt-10 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {como_funciona.pasos.map((c: { titulo: string; texto: string }, i: number) => (
          <li>
            <p class="text-sm font-mono text-[var(--color-granate)] mb-3">{String(i + 1).padStart(2, "0")}</p>
            <h3 class="text-xl font-semibold text-[var(--color-tinta)] mb-2">{c.titulo}</h3>
            <p class="text-[var(--color-cuerpo)] leading-relaxed">{c.texto}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 6. Quién lo facilita -->
  <section class="mx-auto max-w-[var(--container-content)] px-6 py-16">
    <h2 class={h2}>{facilitadores.titulo}</h2>
    <div class="mt-8 grid gap-8 md:grid-cols-2">
      {facilitadores.personas.map((f: { nombre: string; rol: string; bio: string }) => (
        <article class="rounded-2xl border border-black/5 bg-white p-6">
          <p class="text-xs uppercase tracking-[0.18em] text-[var(--color-granate)] font-medium">{f.rol}</p>
          <h3 class="mt-2 text-xl font-semibold text-[var(--color-tinta)]">{f.nombre}</h3>
          <p class="mt-3 text-[var(--color-cuerpo)] leading-relaxed">{f.bio}</p>
        </article>
      ))}
    </div>
  </section>

  <!-- 7. Fechas, horario y lugar -->
  <section class="bg-[var(--color-papel-soft)]">
    <div class="mx-auto max-w-[var(--container-content)] px-6 py-16">
      <h2 class={h2}>{fechas.titulo}</h2>
      <div class="mt-8 grid gap-10 md:grid-cols-2">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-[var(--color-cuerpo)]">
            <tbody>
              {fechas.dias.map((f: { dia: string; horario: string; nota: string }) => (
                <tr class="border-b border-black/10">
                  <th scope="row" class="py-3 pr-4 font-medium text-[var(--color-tinta)] align-top">{f.dia}</th>
                  <td class="py-3 pr-4 align-top whitespace-nowrap">{f.horario}</td>
                  <td class="py-3 align-top text-[var(--color-muted)]">{f.nota}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <div class="space-y-4 text-[var(--color-cuerpo)] leading-relaxed">
          <p>
            <strong class="text-[var(--color-tinta)]">{fechas.lugar.nombre}</strong><br />
            {fechas.lugar.direccion}
          </p>
          {fechas.lugar.notas.map((n: string) => <p set:html={md(n)} />)}
        </div>
      </div>
    </div>
  </section>

  <!-- 8. Precio y condiciones -->
  <section id="precios" class="mx-auto max-w-[var(--container-content)] px-6 py-16 scroll-mt-20">
    <h2 class={h2}>{precio.titulo}</h2>
    <p class="mt-4 text-lg text-[var(--color-cuerpo)] leading-relaxed max-w-2xl">{precio.intro}</p>
    <div class="mt-10 grid gap-6 md:grid-cols-2">
      {precio.opciones.map((p: { titulo: string; precio: string; nota: string; boton: string; enlace: string }) => (
        <div class="rounded-2xl border border-black/10 bg-white p-8 flex flex-col">
          <h3 class="text-xl font-semibold text-[var(--color-tinta)]">{p.titulo}</h3>
          <p class="mt-6 text-5xl font-bold text-[var(--color-granate)]">{p.precio}</p>
          <p class="mt-2 text-[var(--color-cuerpo)]">{p.nota}</p>
          <a href={url(p.enlace)} target="_blank" rel="noopener noreferrer" class={`mt-8 self-start ${botonPrimario}`}>
            {p.boton}
          </a>
        </div>
      ))}
    </div>

    <h3 class={`mt-12 ${eyebrowGranate}`}>{precio.condiciones.titulo}</h3>
    <ul class="mt-4 space-y-3 text-[var(--color-cuerpo)] leading-relaxed max-w-[var(--container-prose)]">
      {precio.condiciones.puntos.map((c: string) => (
        <li class="flex gap-3">
          <span class={`${punto} bg-[var(--color-granate)]`} />
          <span set:html={md(c)} />
        </li>
      ))}
    </ul>
  </section>

  <!-- 9. Lo que dicen quienes lo han hecho -->
  <section class="bg-[var(--color-papel-soft)]">
    <div class="mx-auto max-w-[var(--container-content)] px-6 py-16">
      <h2 class={h2}>{testimonios.titulo}</h2>
      <div class="mt-10 grid gap-8 md:grid-cols-3">
        {testimonios.lista.map((t: { cita: string; autor: string }) => (
          <figure>
            <blockquote class="text-[var(--color-tinta)] leading-relaxed">{t.cita}</blockquote>
            <figcaption class="attribution mt-4">{t.autor}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- 10. Preguntas frecuentes -->
  <section class="mx-auto max-w-[var(--container-content)] px-6 py-16">
    <h2 class={h2}>{preguntas.titulo}</h2>
    <dl class="mt-10 grid gap-x-12 gap-y-10 md:grid-cols-2">
      {preguntas.lista.map((f: { pregunta: string; respuesta: string }) => (
        <div>
          <dt class="text-lg font-semibold text-[var(--color-tinta)]">{f.pregunta}</dt>
          <dd class="mt-2 text-[var(--color-cuerpo)] leading-relaxed" set:html={md(f.respuesta)} />
        </div>
      ))}
    </dl>
  </section>

  <!-- 11. Cierre -->
  <section class="bg-[var(--color-papel-soft)]">
    <div class="mx-auto max-w-[var(--container-content)] px-6 py-20">
      <p class="eyebrow mb-6">{cierre.etiqueta}</p>
      <h2 class={`${h2} max-w-2xl`}>{cierre.titulo}</h2>
      <p class="mt-6 text-lg text-[var(--color-cuerpo)] leading-relaxed max-w-2xl">{cierre.texto}</p>
      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a href="#precios" class={botonPrimario}>{cierre.boton}</a>
        <a href={url("@contacto")} class="font-medium">{cierre.contacto_texto}</a>
      </div>
    </div>
  </section>

  {/* ===== QUÉ HAY QUE DECIDIR (solo en el borrador) ===== */}
  <section class="bg-[var(--color-tinta)] text-white">
    <div class="mx-auto max-w-[var(--container-wide)] px-6 py-16">
      <h2 class="text-2xl md:text-3xl font-semibold text-white">{borrador.decisiones_titulo}</h2>
      <p class="mt-3 text-white/70 max-w-2xl">{borrador.decisiones_intro}</p>
      <ol class="mt-8 space-y-4 max-w-3xl">
        {borrador.decisiones.map((d: string, i: number) => (
          <li class="flex gap-4">
            <span class="font-mono text-sm text-white/50 pt-1 shrink-0">{String(i + 1).padStart(2, "0")}</span>
            <span class="text-white/90 leading-relaxed">{d}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>
</Base>
