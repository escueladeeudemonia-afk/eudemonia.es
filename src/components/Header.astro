---
const nav = [
  { label: "Inicio", href: "/" },
  { label: "Fundación", href: "/fundacion" },
  { label: "Organizaciones", href: "/organizaciones" },
  { label: "La Escuela", href: "/la-escuela" },
  { label: "Participa", href: "/participa" },
];

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header class="border-b border-black/5 bg-[var(--color-papel)]/90 backdrop-blur sticky top-0 z-30">
  <div class="mx-auto max-w-[var(--container-wide)] px-6 py-4 flex items-center justify-between gap-6">
    <a href="/" class="flex items-center gap-3 no-underline">
      <img src="/brand/isotipo.svg" alt="" width="36" height="36" class="shrink-0" />
      <span class="font-semibold text-[var(--color-tinta)] tracking-tight">
        Eudemonía
      </span>
    </a>

    <nav class="hidden md:flex items-center gap-6 text-sm">
      {
        nav.map((item) => {
          const active = pathname === item.href || (item.href !== "/" && pathname.startsWith(item.href));
          return (
            <a
              href={item.href}
              class:list={[
                "no-underline transition-colors",
                active
                  ? "text-[var(--color-granate)] font-medium"
                  : "text-[var(--color-cuerpo)] hover:text-[var(--color-granate)]",
              ]}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>

    {/* Menú mobile */}
    <details class="md:hidden">
      <summary class="list-none cursor-pointer p-2" aria-label="Abrir menú">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="4" x2="20" y1="6" y2="6" />
          <line x1="4" x2="20" y1="12" y2="12" />
          <line x1="4" x2="20" y1="18" y2="18" />
        </svg>
      </summary>
      <div class="absolute right-4 top-16 bg-[var(--color-papel)] border border-black/10 rounded-lg shadow-lg p-4 flex flex-col gap-3 min-w-[200px]">
        {nav.map((item) => <a href={item.href} class="text-sm no-underline text-[var(--color-cuerpo)]">{item.label}</a>)}
      </div>
    </details>
  </div>
</header>
