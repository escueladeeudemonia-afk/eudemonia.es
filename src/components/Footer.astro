---
import { navegacion } from "../data/navegacion";

const year = new Date().getFullYear();
---

<footer class="border-t border-black/5 bg-[var(--color-papel-soft)] mt-24">
  <div class="mx-auto max-w-[var(--container-wide)] px-6 py-12 grid gap-10 lg:grid-cols-[minmax(0,16rem)_1fr]">
    <div>
      <div class="flex items-center gap-3 mb-3">
        <img src="/brand/isotipo.svg" alt="" width="32" height="32" />
        <span class="font-semibold text-[var(--color-tinta)]">Fundación Eudemonía</span>
      </div>
      <p class="text-sm text-[var(--color-muted)] leading-relaxed max-w-xs">
        Desarrollamos liderazgo para construir una mejor sociedad.
      </p>
    </div>

    <nav class="grid gap-8 sm:grid-cols-2 xl:grid-cols-4" aria-label="Secundaria">
      {
        navegacion.map((grupo) => (
          <div>
            <p class="text-xs font-medium uppercase tracking-[0.14em] text-[var(--color-granate)]">{grupo.label}</p>
            <div class="mt-3 flex flex-col gap-2">
              {grupo.enlaces.map((enlace) => (
                <a href={enlace.href} class="text-sm text-[var(--color-cuerpo)] hover:text-[var(--color-granate)] no-underline">
                  {enlace.label}
                </a>
              ))}
            </div>
          </div>
        ))
      }
    </nav>
  </div>

  <div class="border-t border-black/5">
    <div class="mx-auto max-w-[var(--container-wide)] px-6 py-4 text-xs text-[var(--color-muted)] flex flex-wrap justify-between gap-x-6 gap-y-2">
      <span>© {year} Fundación Eudemonía</span>
      <nav class="flex flex-wrap gap-x-4 gap-y-1">
        <a href="/aviso-legal" class="hover:text-[var(--color-granate)] no-underline">Aviso legal</a>
        <a href="/privacidad" class="hover:text-[var(--color-granate)] no-underline">Privacidad</a>
        <a href="/cookies" class="hover:text-[var(--color-granate)] no-underline">Cookies</a>
        <a href="/transparencia" class="hover:text-[var(--color-granate)] no-underline">Transparencia</a>
      </nav>
    </div>
  </div>
</footer>
