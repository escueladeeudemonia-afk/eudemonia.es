---
interface Props {
  /** ID numérico del formulario MailerLite, ej. "6132167" */
  formId: string;
  /** Código del formulario en la URL de submit, ej. "d4r9a4" */
  code: string;
  /** A dónde redirige tras un envío correcto (normalmente /gracias) */
  redirectUrl: string;
  submitLabel: string;
  /** Medir solo los formularios de captación que entregan este recurso. */
  leadMagnet?: "libro" | "estoicismo";
  emailPlaceholder?: string;
  namePlaceholder?: string;
}

const {
  formId,
  code,
  redirectUrl,
  submitLabel,
  leadMagnet,
  emailPlaceholder = "Correo",
  namePlaceholder = "Nombre",
} = Astro.props;

const isConfigured = Boolean(formId.trim() && code.trim());
const successScript = `
(function () {
  let completado = false;
  window[${JSON.stringify(`ml_webform_success_${formId}`)}] = function ml_webform_success_${formId}() {
    if (completado) return;
    completado = true;
    let redirigido = false;
    function continuar() {
      if (redirigido) return;
      redirigido = true;
      try { window.top.location.href = ${JSON.stringify(redirectUrl)}; }
      catch (e) { window.location.href = ${JSON.stringify(redirectUrl)}; }
    }
    const recurso = ${JSON.stringify(leadMagnet ?? null)};
    if (!recurso || typeof window.gtag !== "function") {
      continuar();
      return;
    }
    // El éxito lo confirma MailerLite: ni el clic ni una visita a /gracias/ son leads.
    // Esperar al tag antes de navegar; el plazo independiente cubre bloqueadores.
    window.setTimeout(continuar, 1500);
    try {
      window.gtag("event", "generate_lead", {
        lead_magnet: recurso,
        form_id: ${JSON.stringify(formId)},
        event_callback: continuar,
        event_timeout: 1500
      });
    } catch (e) { continuar(); }
  };
})();`;
---

<div id={formId ? `mlb2-${formId}` : undefined} class="ml-form-embedContainer ml-subscribe-form w-full">
  <div class="ml-form-embedWrapper">
    <div class="ml-form-embedBody row-form">
      <form
        class="ml-block-form flex flex-col gap-4"
        action={`https://static.mailerlite.com/webforms/submit/${code}`}
        data-code={code}
        method="post"
        target="_blank"
      >
        <div class="ml-form-formContent flex flex-col gap-4">
          <div class="ml-form-fieldRow ml-field-group ml-field-name">
            <input
              aria-label="Nombre"
              type="text"
              name="fields[name]"
              placeholder={namePlaceholder}
              autocomplete="given-name"
              class="w-full rounded-lg border-2 border-[var(--color-tinta)]/25 bg-white px-4 py-3 text-[var(--color-cuerpo)] placeholder:text-[var(--color-muted)] focus:outline-none focus:border-[var(--color-granate)]"
            />
          </div>
          <div class="ml-form-fieldRow ml-last-item ml-field-group ml-field-email ml-validate-email ml-validate-required">
            <input
              aria-label="Correo electrónico"
              aria-required="true"
              type="email"
              name="fields[email]"
              placeholder={emailPlaceholder}
              autocomplete="email"
              required
              class="w-full rounded-lg border-2 border-[var(--color-tinta)]/25 bg-white px-4 py-3 text-[var(--color-cuerpo)] placeholder:text-[var(--color-muted)] focus:outline-none focus:border-[var(--color-granate)]"
            />
          </div>
        </div>
        <div class="ml-form-checkboxRow ml-validate-required">
          <label class="checkbox flex items-start gap-2 text-sm text-[var(--color-muted)]">
            <input type="checkbox" required class="mt-1 accent-[var(--color-granate)]" />
            <span class="label-description">
              He leído y acepto la <a href="/privacidad/" class="underline">política de privacidad</a>
            </span>
          </label>
        </div>
        <input type="hidden" name="ml-submit" value="1" />
        <div class="ml-form-embedSubmit">
          <button
            type="submit"
            disabled={!isConfigured}
            class="primary inline-flex w-full items-center justify-center gap-2 rounded-full bg-[var(--color-granate)] px-6 py-3 text-white font-medium hover:bg-[var(--color-granate-dark)] transition-colors"
          >
            {submitLabel}
          </button>
          <button
            disabled
            style="display:none"
            type="button"
            class="loading inline-flex w-full items-center justify-center gap-2 rounded-full bg-[var(--color-granate)] px-6 py-3 text-white font-medium"
          >
            <div class="ml-form-embedSubmitLoad" />
            <span class="sr-only">Cargando...</span>
          </button>
        </div>
        <input type="hidden" name="anticsrf" value="true" />
      </form>
    </div>
    <div class="ml-form-successBody row-success" style="display:none">
      <div class="ml-form-successContent">
        <h4 class="text-xl font-semibold text-[var(--color-tinta)]">¡Ya casi está!</h4>
        <p class="mt-2 text-[var(--color-cuerpo)]">Revisa tu correo para confirmar la suscripción.</p>
      </div>
    </div>
  </div>
</div>

{isConfigured && <img
  src={`https://track.mailerlite.com/webforms/o/${formId}/${code}`}
  width="1"
  height="1"
  style="max-width:1px;max-height:1px;visibility:hidden;padding:0;margin:0;display:block"
  alt="."
/>}
{isConfigured && <script is:inline set:html={successScript} />}
{isConfigured && <script is:inline src="https://static.mailerlite.com/js/w/webforms.min.js?vd4de52e171e8eb9c47c0c20caf367ddf"></script>}

<style>
  .ml-form-embedSubmitLoad {
    display: inline-block;
    width: 20px;
    height: 20px;
  }
  .ml-form-embedSubmitLoad:after {
    content: " ";
    display: block;
    width: 11px;
    height: 11px;
    margin: 1px;
    border-radius: 50%;
    border: 4px solid #fff;
    border-color: #fff #fff #fff transparent;
    animation: ml-form-embedSubmitLoad 1.2s linear infinite;
  }
  @keyframes ml-form-embedSubmitLoad {
    0% {
      transform: rotate(0);
    }
    100% {
      transform: rotate(360deg);
    }
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
  }
</style>
