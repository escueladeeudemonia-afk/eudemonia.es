---
import type { suscripcionEpistolas } from "../data/suscripcion.mjs";

interface Props {
  /** ID numérico del formulario MailerLite, ej. "6132167" */
  formId?: string;
  /** Código del formulario en la URL de submit, ej. "d4r9a4" */
  code?: string;
  /** A dónde redirige tras un envío correcto (normalmente /gracias) */
  redirectUrl: string;
  submitLabel: string;
  emailPlaceholder?: string;
  namePlaceholder?: string;
  wordpress?: typeof suscripcionEpistolas.wordpress;
}

const {
  formId = "",
  code = "",
  redirectUrl,
  submitLabel,
  emailPlaceholder = "Correo",
  namePlaceholder = "Nombre",
  wordpress,
} = Astro.props;

const isConfigured = !wordpress && Boolean(formId.trim() && code.trim());
const successScript = `function ml_webform_success_${formId}(){try{window.top.location.href=${JSON.stringify(redirectUrl)}}catch(e){window.location.href=${JSON.stringify(redirectUrl)}}}`;
---

<div id={wordpress ? `kb-form-${wordpress.formId}` : formId ? `mlb2-${formId}` : undefined} class:list={["w-full", { "ml-form-embedContainer ml-subscribe-form": !wordpress }]}>
  <div class="ml-form-embedWrapper">
    <div class="ml-form-embedBody row-form">
      <form
        class="ml-block-form flex flex-col gap-4"
        action={wordpress?.endpoint ?? `https://static.mailerlite.com/webforms/submit/${code}`}
        data-code={wordpress ? undefined : code}
        data-newsletter-wordpress={wordpress ? "true" : undefined}
        data-context-url={wordpress?.contextEndpoint}
        method="post"
        target={wordpress ? undefined : "_blank"}
      >
        <div class="ml-form-formContent flex flex-col gap-4">
          {!wordpress && <div class="ml-form-fieldRow ml-field-group ml-field-name">
            <input
              aria-label="name"
              type="text"
              name="fields[name]"
              placeholder={namePlaceholder}
              autocomplete="given-name"
              class="w-full rounded-lg border-2 border-[var(--color-tinta)]/25 bg-white px-4 py-3 text-[var(--color-cuerpo)] placeholder:text-[var(--color-muted)] focus:outline-none focus:border-[var(--color-granate)]"
            />
          </div>}
          <div class="ml-form-fieldRow ml-last-item ml-field-group ml-field-email ml-validate-email ml-validate-required">
            <input
              aria-label="Correo electrónico"
              aria-required="true"
              type="email"
              name={wordpress ? "kb_field_0" : "fields[email]"}
              placeholder={emailPlaceholder}
              autocomplete="email"
              required
              class="w-full rounded-lg border-2 border-[var(--color-tinta)]/25 bg-white px-4 py-3 text-[var(--color-cuerpo)] placeholder:text-[var(--color-muted)] focus:outline-none focus:border-[var(--color-granate)]"
            />
          </div>
        </div>
        <div class="ml-form-checkboxRow ml-validate-required">
          <label class="checkbox flex items-start gap-2 text-sm text-[var(--color-muted)]">
            <input type="checkbox" name={wordpress ? "kb_field_1" : undefined} value={wordpress ? "accept" : undefined} required class="mt-1 accent-[var(--color-granate)]" />
            <span class="label-description">
              He leído y acepto la <a href="/privacidad/" class="underline">política de privacidad</a>
            </span>
          </label>
        </div>
        {wordpress ? <>
          <input type="hidden" name="_kb_form_id" value={wordpress.formId} />
          <input type="hidden" name="_kb_form_post_id" value={wordpress.postId} />
          <input type="hidden" name="action" value="kb_process_ajax_submit" />
          <label class="sr-only" aria-hidden="true">
            Deja este campo vacío
            <input type="text" name="_kb_verify_email" tabindex="-1" autocomplete="off" data-1p-ignore="true" data-lpignore="true" />
          </label>
        </> : <input type="hidden" name="ml-submit" value="1" />}
        <div class="ml-form-embedSubmit">
          <button
            type="submit"
            disabled={!isConfigured}
            class="primary inline-flex w-full items-center justify-center gap-2 rounded-full bg-[var(--color-granate)] px-6 py-3 text-white font-medium hover:bg-[var(--color-granate-dark)] disabled:opacity-60 transition-colors"
          >
            {submitLabel}
          </button>
          <button
            disabled
            style="display:none"
            type="button"
            class="loading inline-flex w-full items-center justify-center gap-2 rounded-full bg-[var(--color-granate)] px-6 py-3 text-white font-medium"
          >
            <div class="ml-form-embedSubmitLoad" />
            <span class="sr-only">Cargando...</span>
          </button>
        </div>
        {!wordpress && <input type="hidden" name="anticsrf" value="true" />}
      </form>
      {wordpress && <>
        <p data-newsletter-status role="status" aria-live="polite" class="mt-4 text-sm text-[var(--color-cuerpo)]" hidden></p>
        <p data-newsletter-fallback class="mt-3 text-sm text-[var(--color-cuerpo)]" hidden>
          También puedes <a href={wordpress.fallbackUrl} class="underline underline-offset-4">suscribirte en la web de la Escuela</a>.
        </p>
        <noscript>
          <p class="mt-4 text-sm text-[var(--color-cuerpo)]">
            Para suscribirte, activa JavaScript o <a href={wordpress.fallbackUrl} class="underline">abre el formulario de la Escuela</a>.
          </p>
        </noscript>
      </>}
    </div>
    <div class="ml-form-successBody row-success" style="display:none">
      <div class="ml-form-successContent">
        <h4 class="text-xl font-semibold text-[var(--color-tinta)]">¡Ya casi está!</h4>
        <p class="mt-2 text-[var(--color-cuerpo)]">Revisa tu correo para confirmar la suscripción.</p>
      </div>
    </div>
  </div>
</div>

{isConfigured && <img
  src={`https://track.mailerlite.com/webforms/o/${formId}/${code}`}
  width="1"
  height="1"
  style="max-width:1px;max-height:1px;visibility:hidden;padding:0;margin:0;display:block"
  alt="."
/>}
{isConfigured && <script is:inline set:html={successScript} />}
{isConfigured && <script is:inline src="https://static.mailerlite.com/js/w/webforms.min.js?vd4de52e171e8eb9c47c0c20caf367ddf"></script>}

<script>
  import { enviarSuscripcion } from "../scripts/suscripcion.mjs";

  document.querySelectorAll<HTMLFormElement>("form[data-newsletter-wordpress]").forEach((form) => {
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const status = form.parentElement?.querySelector<HTMLElement>("[data-newsletter-status]");
    const fallback = form.parentElement?.querySelector<HTMLElement>("[data-newsletter-fallback]");
    if (!button || !status || !fallback) return;
    button.disabled = false;
    let sending = false;

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (sending || !form.reportValidity()) return;
      sending = true;
      button.disabled = true;
      form.setAttribute("aria-busy", "true");
      status.hidden = false;
      fallback.hidden = true;
      status.textContent = "Enviando…";
      try {
        await enviarSuscripcion(new FormData(form), form.action, form.dataset.contextUrl);
        form.hidden = true;
        status.textContent = "Solicitud recibida. Si recibes un correo de confirmación, sigue sus indicaciones.";
      } catch {
        status.textContent = "No hemos podido confirmar la suscripción. Puedes intentarlo más tarde o usar el formulario de la Escuela.";
        fallback.hidden = false;
      } finally {
        sending = false;
        button.disabled = false;
        form.removeAttribute("aria-busy");
      }
    });
  });
</script>

<style>
  .ml-form-embedSubmitLoad {
    display: inline-block;
    width: 20px;
    height: 20px;
  }
  .ml-form-embedSubmitLoad:after {
    content: " ";
    display: block;
    width: 11px;
    height: 11px;
    margin: 1px;
    border-radius: 50%;
    border: 4px solid #fff;
    border-color: #fff #fff #fff transparent;
    animation: ml-form-embedSubmitLoad 1.2s linear infinite;
  }
  @keyframes ml-form-embedSubmitLoad {
    0% {
      transform: rotate(0);
    }
    100% {
      transform: rotate(360deg);
    }
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
  }
</style>
